# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=documind_chunks

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# --- Traitement des documents ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBED_BATCH_SIZE=32
MAX_UPLOAD_MB=50

# --- RAG ---
RETRIEVAL_TOP_K=5

# --- Sécurité (appels entre le backend Node et l'ai-service) ---
INTERNAL_API_KEY=change-me